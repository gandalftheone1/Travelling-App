<script type="text/phast">document.addEventListener("DOMContentLoaded",function(){function displayTime(zone,element){var now=new Date();var options={timeZone:zone,hour12:true,hour:'numeric',minute:'numeric'};var localTime=now.toLocaleString('en-US',options);element.innerHTML=localTime;}
var clocks=document.querySelectorAll('.clock');clocks.forEach(function(clock){var timezone=clock.getAttribute('data-timezone');var clockElement=clock.querySelector('.localClock');if(clockElement){displayTime(timezone,clockElement);}});});</script>
